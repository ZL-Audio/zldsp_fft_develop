include_guard(GLOBAL)

block()
    if(NOT ZLDSP_FFT_SEPARATE_TARGETS)
        message(FATAL_ERROR "Set ZLDSP_FFT_SEPARATE_TARGETS to a list of SSE2, SSE4, and/or AVX2.")
    endif()

    set(supported_targets SSE2 AVX2)
    if(MSVC AND NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        set(flags_SSE2 "")
        set(flags_AVX2 /arch:AVX2)
    else()
        list(APPEND supported_targets SSE4)
        set(flags_SSE2 -march=x86-64)
        set(flags_SSE4 -march=x86-64-v2 -maes -mpclmul)
        set(flags_AVX2 -march=x86-64-v3 -maes -mpclmul)
    endif()

    add_library(zldsp_fft_separate_dispatch STATIC
        "${CMAKE_CURRENT_LIST_DIR}/separate_dispatch_wrapper.cpp")
    target_include_directories(zldsp_fft_separate_dispatch PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
    set(components zldsp_fft_separate_dispatch)
    set(backends "")

    foreach(isa IN LISTS ZLDSP_FFT_SEPARATE_TARGETS)
        if(NOT "${isa}" IN_LIST supported_targets)
            message(FATAL_ERROR "Unsupported FFT target for ${CMAKE_CXX_COMPILER_ID}: ${isa}")
        endif()
        set(flags ${flags_${isa}})
        if(MSVC AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
            list(TRANSFORM flags PREPEND "/clang:")
        endif()

        string(TOLOWER "zldsp_fft_${isa}" target)
        add_library(${target} OBJECT "${CMAKE_CURRENT_LIST_DIR}/dynamic_dispatch_wrapper.cpp")
        target_compile_definitions(${target} PRIVATE
            HWY_COMPILE_ONLY_STATIC "ZLDSP_FFT_BACKEND_ONLY=HWY_${isa}")
        target_compile_options(${target} PRIVATE ${flags})
        target_link_libraries(zldsp_fft_separate_dispatch PRIVATE ${target})
        list(APPEND components ${target})
        string(APPEND backends "ZLDSP_FFT_BACKEND(${isa})")
    endforeach()
    target_compile_definitions(zldsp_fft_separate_dispatch PRIVATE
        "ZLDSP_FFT_SEPARATE_TARGETS=${backends}")

    foreach(target IN LISTS components)
        target_compile_features(${target} PUBLIC cxx_std_20)
        target_link_libraries(${target} PRIVATE hwy)
        target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../zldsp_fft")
    endforeach()
endblock()
